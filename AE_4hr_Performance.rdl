  <DataSets>
    <DataSet Name="dsRegions">
      <Query>
        <DataSourceName>ds_NHS_AE</DataSourceName>
        <CommandText>SELECT DISTINCT ParentOrg FROM dbo.ae_clean ORDER BY ParentOrg;</CommandText>
      </Query>
      <Fields>
        <Field Name="ParentOrg">
          <DataField>ParentOrg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsAE">
      <Query>
        <DataSourceName>ds_NHS_AE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Region">
            <Value>=Parameters!Region.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT PeriodDate, ParentOrg, OrgCode, OrgName,
       TotalAttendances, TotalOver4hrs, PctWithin4hrs
FROM dbo.ae_clean
WHERE ParentOrg IN (@Region); </CommandText>
      </Query>
      <Fields>
        <Field Name="PeriodDate">
          <DataField>PeriodDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ParentOrg">
          <DataField>ParentOrg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
