        </Field>
        <Field Name="OrgName">
          <DataField>OrgName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalAttendances">
          <DataField>TotalAttendances</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalOver4hrs">
          <DataField>TotalOver4hrs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PctWithin4hrs">
          <DataField>PctWithin4hrs</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
